# Copy to .env and fill in locally. .env is gitignored and must never be committed.
# The published static build does NOT need any of this — it runs the deterministic engine.

# Server-side only. Never referenced by browser code.
ANTHROPIC_API_KEY=

# Optional. Defaults to 3000.
PORT=3000

# Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5
